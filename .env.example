# Copie para .env e ajuste. Nenhum valor abaixo é um segredo real.

# Porta e endereço de escuta do servidor
PORT=3000
HOST=127.0.0.1

# Caminho do arquivo SQLite (criado automaticamente)
DATABASE_PATH=./data/escalas.db

# development | production. Em produção, SESSION_SECRET é obrigatório e COOKIE_SECURE é ativado.
NODE_ENV=development

# Segredo para os tokens CSRF (mínimo de 32 caracteres). Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Duração da sessão em horas
SESSION_TTL_HORAS=12

# true quando o sistema for servido por HTTPS (cookie com flag Secure)
COOKIE_SECURE=false

# Limite de tentativas de login por e-mail+IP dentro da janela (minutos)
LOGIN_MAX_TENTATIVAS=5
LOGIN_JANELA_MINUTOS=15

# Senhas dos usuários de demonstração criados por "npm run seed".
# Se ficarem vazias, o seed gera senhas aleatórias e as imprime uma única vez.
SEED_ADMIN_PASSWORD=
SEED_USER_PASSWORD=
